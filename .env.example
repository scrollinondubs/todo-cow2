# Turso/libSQL database connection
# Create a database with the Turso CLI: turso db create todo-cow
# Get the URL: turso db show todo-cow --url
# Get an auth token: turso db tokens create todo-cow
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# For local development without Turso, point at a local SQLite file instead:
# TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN is not needed for a local file database.
